{
  "name": "accivia",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @accivia/api\" \"npm run dev --workspace @accivia/web\"",
    "build": "npm run build --workspace @accivia/api && npm run build --workspace @accivia/web",
    "test": "npm run test --workspace @accivia/api",
    "test:integration": "npm run test:integration --workspace @accivia/api",
    "db:generate": "npm run db:generate --workspace @accivia/api",
    "db:push": "npm run db:push --workspace @accivia/api",
    "db:seed": "npm run db:seed --workspace @accivia/api"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
