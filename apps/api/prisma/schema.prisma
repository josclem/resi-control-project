generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMINISTRADOR
  ADMINISTRADOR
  VIGILANTE
  RESIDENTE
  PERSONALIZADO
}

enum PersonType {
  RESIDENTE
  VISITANTE
}

enum BuildingSectionType {
  TORRE
  INTERIOR
}

enum AccessType {
  ENTRADA
  SALIDA
}

enum VehicleType {
  AUTOMOVIL
  MOTOCICLETA
  BICICLETA
  OTRO
}

enum DeliveryType {
  COMIDA
  PAQUETE
  RECIBO
  CORREO
  OTRO
}

enum DeliveryStatus {
  PENDIENTE
  ENTREGADA
  DEVUELTA
}

enum VisitStatus {
  AUTORIZADA
  CANCELADA
  NOSHOW
  EN_CURSO
  COMPLETADA
}

enum VisitOrigin {
  RESIDENTE
  PORTERIA
}

enum ResidentCommunicationType {
  ADMINISTRATIVE
  PROMOTIONAL
}

enum ResidentCommunicationStatus {
  SENDING
  COMPLETED
  PARTIAL
  FAILED
}

enum ResidentCommunicationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum ResidentEmailConsentAction {
  GRANTED
  WITHDRAWN
}

model Residence {
  id             Int                     @id @default(autoincrement())
  name           String
  code           String                  @unique
  active         Boolean                 @default(true)
  logoData       Bytes?
  logoMimeType   String?
  createdAt      DateTime                @default(now())
  users          User[]
  people         Person[]
  vehicles       Vehicle[]
  accessLogs     AccessLog[]
  settings       SystemSetting[]
  deliveries     Delivery[]
  customRoles    CustomRole[]
  visits         VisitPreRegistration[]
  communications ResidentCommunication[]
}

model User {
  id                         Int                         @id @default(autoincrement())
  name                       String
  email                      String                      @unique
  passwordHash               String
  role                       UserRole
  active                     Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  residenceId                Int                         @default(1)
  residence                  Residence                   @relation(fields: [residenceId], references: [id])
  customRoleId               Int?
  customRole                 CustomRole?                 @relation("UserCustomRole", fields: [customRoleId], references: [id])
  residentPersonId           Int?                        @unique
  residentPerson             Person?                     @relation("ResidentAccount", fields: [residentPersonId], references: [id])
  accessLogs                 AccessLog[]
  authorizedAccessLogs       AccessLog[]                 @relation("AccessOverride")
  receivedDeliveries         Delivery[]                  @relation("DeliveryReceived")
  deliveredDeliveries        Delivery[]                  @relation("DeliveryDelivered")
  customRolesCreated         CustomRole[]                @relation("CustomRoleCreator")
  residentInvitationsCreated ResidentInvitation[]        @relation("ResidentInvitationCreator")
  visitsCreated              VisitPreRegistration[]      @relation("VisitCreator")
  communicationsCreated      ResidentCommunication[]
  residentEmailConsentEvents ResidentEmailConsentEvent[] @relation("ResidentEmailConsentRecorder")
  passwordResetTokens       PasswordResetToken[]
}

model CustomRole {
  id          Int       @id @default(autoincrement())
  name        String
  permissions String[]
  active      Boolean   @default(true)
  residenceId Int
  createdById Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  residence   Residence @relation(fields: [residenceId], references: [id])
  createdBy   User      @relation("CustomRoleCreator", fields: [createdById], references: [id])
  users       User[]    @relation("UserCustomRole")

  @@unique([residenceId, name])
  @@index([residenceId, active])
}

model Person {
  id                             Int                         @id @default(autoincrement())
  accessCode                     String                      @unique @default(uuid())
  type                           PersonType
  fullName                       String
  documentNumber                 String?
  documentTypeId                 Int?
  buildingSectionType            BuildingSectionType?
  buildingSectionNumber          String?
  apartmentNumber                String
  phone                          String?
  email                          String?
  promotionalEmailConsentAt      DateTime?
  promotionalEmailConsentSource  String?
  promotionalEmailConsentEmail   String?
  promotionalEmailUnsubscribedAt DateTime?
  biometricRef                   String?                     @unique
  active                         Boolean                     @default(true)
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  residenceId                    Int                         @default(1)
  residence                      Residence                   @relation(fields: [residenceId], references: [id])
  accessLogs                     AccessLog[]
  vehicles                       Vehicle[]
  documentType                   DocumentType?               @relation(fields: [documentTypeId], references: [id])
  photo                          PersonPhoto?
  deliveries                     Delivery[]
  residentUser                   User?                       @relation("ResidentAccount")
  residentInvitations            ResidentInvitation[]
  residentVisits                 VisitPreRegistration[]      @relation("VisitResident")
  visitsAsVisitor                VisitPreRegistration[]      @relation("VisitVisitor")
  emailConsentEvents             ResidentEmailConsentEvent[]

  @@unique([residenceId, documentTypeId, documentNumber])
  @@index([fullName])
  @@index([apartmentNumber])
  @@index([residenceId, buildingSectionType, buildingSectionNumber])
}

model PersonPhoto {
  id        Int      @id @default(autoincrement())
  data      Bytes
  mimeType  String
  fileName  String?
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  personId  Int      @unique
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id          Int           @id @default(autoincrement())
  accessCode  String        @unique @default(uuid())
  plate       String
  type        VehicleType
  brand       String?
  model       String?
  color       String?
  active      Boolean       @default(true)
  personId    Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  residenceId Int           @default(1)
  residence   Residence     @relation(fields: [residenceId], references: [id])
  person      Person        @relation(fields: [personId], references: [id])
  accessLogs  AccessLog[]
  photo       VehiclePhoto?

  @@unique([residenceId, plate])
  @@index([personId])
}

model VehiclePhoto {
  id        Int      @id @default(autoincrement())
  data      Bytes
  mimeType  String
  fileName  String?
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicleId Int      @unique
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model DocumentType {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  people    Person[]
}

model AccessLog {
  id                     Int                   @id @default(autoincrement())
  accessType             AccessType
  occurredAt             DateTime              @default(now())
  personId               Int
  vehicleId              Int?
  registeredById         Int
  overrideAuthorizedById Int?
  visitPreRegistrationId Int?
  residenceId            Int                   @default(1)
  residence              Residence             @relation(fields: [residenceId], references: [id])
  person                 Person                @relation(fields: [personId], references: [id])
  vehicle                Vehicle?              @relation(fields: [vehicleId], references: [id])
  registeredBy           User                  @relation(fields: [registeredById], references: [id])
  overrideAuthorizedBy   User?                 @relation("AccessOverride", fields: [overrideAuthorizedById], references: [id])
  visitPreRegistration   VisitPreRegistration? @relation(fields: [visitPreRegistrationId], references: [id])

  @@index([occurredAt])
  @@index([accessType])
  @@index([vehicleId])
  @@index([visitPreRegistrationId])
}

model VisitPreRegistration {
  id                        Int          @id @default(autoincrement())
  visitorName               String
  visitorDocumentNumber     String?
  observations              String?
  vehiclePlate              String?
  vehicleType               VehicleType?
  validFrom                 DateTime
  validUntil                DateTime
  status                    VisitStatus  @default(AUTORIZADA)
  origin                    VisitOrigin
  residentApprovalConfirmed Boolean      @default(false)
  createdAt                 DateTime     @default(now())
  canceledAt                DateTime?
  checkedInAt               DateTime?
  checkedOutAt              DateTime?
  residentPersonId          Int
  visitorPersonId           Int?
  createdById               Int
  residenceId               Int          @default(1)
  resident                  Person       @relation("VisitResident", fields: [residentPersonId], references: [id])
  visitor                   Person?      @relation("VisitVisitor", fields: [visitorPersonId], references: [id])
  createdBy                 User         @relation("VisitCreator", fields: [createdById], references: [id])
  residence                 Residence    @relation(fields: [residenceId], references: [id])
  accessLogs                AccessLog[]

  @@index([residenceId, status, validUntil])
  @@index([residentPersonId, createdAt])
}

model SystemSetting {
  id          Int       @id @default(autoincrement())
  key         String
  value       String
  residenceId Int       @default(1)
  residence   Residence @relation(fields: [residenceId], references: [id])
  updatedAt   DateTime  @updatedAt

  @@unique([residenceId, key])
}

model ResidentCommunication {
  id             Int                              @id @default(autoincrement())
  type           ResidentCommunicationType
  subject        String
  body           String
  status         ResidentCommunicationStatus      @default(SENDING)
  audienceStatus String
  audienceFilter Json
  createdAt      DateTime                         @default(now())
  completedAt    DateTime?
  createdById    Int
  residenceId    Int
  createdBy      User                             @relation(fields: [createdById], references: [id])
  residence      Residence                        @relation(fields: [residenceId], references: [id])
  recipients     ResidentCommunicationRecipient[]

  @@index([residenceId, createdAt])
}

model ResidentCommunicationRecipient {
  id                   Int                                 @id @default(autoincrement())
  email                String
  personIds            Int[]
  residentNames        String[]
  status               ResidentCommunicationDeliveryStatus @default(PENDING)
  error                String?
  sentAt               DateTime?
  unsubscribeTokenHash String?                             @unique
  communicationId      Int
  communication        ResidentCommunication               @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@unique([communicationId, email])
  @@index([communicationId, status])
}

model ResidentEmailConsentEvent {
  id           Int                        @id @default(autoincrement())
  action       ResidentEmailConsentAction
  email        String
  source       String
  authorizationReasonId Int?
  createdAt    DateTime                   @default(now())
  personId     Int
  recordedById Int?
  person       Person                     @relation(fields: [personId], references: [id])
  recordedBy   User?                      @relation("ResidentEmailConsentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  authorizationReason AuthorizationReason? @relation(fields: [authorizationReasonId], references: [id], onDelete: SetNull)

  @@index([personId, createdAt])
}

model AuthorizationReason {
  id                    Int                         @id @default(autoincrement())
  code                  String                      @unique
  description           String
  active                Boolean                     @default(true)
  createdAt             DateTime                    @default(now())
  consentEvents         ResidentEmailConsentEvent[]
}

model ResidentInvitation {
  id          Int       @id @default(autoincrement())
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  personId    Int
  createdById Int
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("ResidentInvitationCreator", fields: [createdById], references: [id])

  @@index([personId, expiresAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Delivery {
  id              Int            @id @default(autoincrement())
  type            DeliveryType
  status          DeliveryStatus @default(PENDIENTE)
  courier         String?
  description     String?
  trackingCode    String?
  notes           String?
  receivedAt      DateTime       @default(now())
  deliveredAt     DateTime?
  deliveredToName String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  personId        Int
  residenceId     Int            @default(1)
  receivedById    Int
  deliveredById   Int?
  person          Person         @relation(fields: [personId], references: [id])
  residence       Residence      @relation(fields: [residenceId], references: [id])
  receivedBy      User           @relation("DeliveryReceived", fields: [receivedById], references: [id])
  deliveredBy     User?          @relation("DeliveryDelivered", fields: [deliveredById], references: [id])

  @@index([status])
  @@index([receivedAt])
  @@index([personId])
}
